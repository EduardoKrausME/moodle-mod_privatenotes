{{#hasrows}}
<table class="generaltable table table-striped">
    <thead>
        <tr>
            <th scope="col">{{#str}} student, mod_privatenotes {{/str}}</th>
            <th scope="col">{{#str}} created, mod_privatenotes {{/str}}</th>
            <th scope="col">{{#str}} modified, mod_privatenotes {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
            <tr>
                <td>{{fullname}}</td>
                <td>{{timecreated}}</td>
                <td>{{timemodified}}</td>
            </tr>
        {{/rows}}
    </tbody>
</table>
{{/hasrows}}
{{^hasrows}}
<div class="alert alert-info">{{#str}} nonotesyet, mod_privatenotes {{/str}}</div>
{{/hasrows}}
